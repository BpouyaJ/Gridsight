  "measures": [
    {
      "dax": "DISTINCTCOUNT('Fact Hourly Energy'[interval_start_utc])",
      "description": "Unique canonical UTC hourly intervals in the current filter context.",
      "display_folder": "Energy",
      "format_string": "#,0",
      "name": "Observed Hours",
      "unit": "count"
    },
    {
      "dax": "DIVIDE(SUM('Fact Hourly Energy'[grid_load_mwh]), 1000000)",
      "description": "Grid-load energy summed over time and converted from MWh to TWh.",
      "display_folder": "Energy",
      "format_string": "0.000 \"TWh\"",
      "name": "Total Grid Load TWh",
      "unit": "TWh"
    },
    {
      "dax": "DIVIDE(AVERAGE('Fact Hourly Energy'[grid_load_mw]), 1000)",
      "description": "Arithmetic mean of hourly average grid load, converted from MW to GW.",
      "display_folder": "Energy",
      "format_string": "0.000 \"GW\"",
      "name": "Average Grid Load GW",
      "unit": "GW"
    },
    {
      "dax": "DIVIDE(MAX('Fact Hourly Energy'[grid_load_mw]), 1000)",
      "description": "Maximum observed hourly average grid load, converted from MW to GW.",
      "display_folder": "Energy",
      "format_string": "0.000 \"GW\"",
      "name": "Peak Grid Load GW",
      "unit": "GW"
    },
    {
      "dax": "DIVIDE(SUM('Fact Hourly Energy'[reported_generation_mwh]), 1000000)",
      "description": "Reported generation energy summed over time and converted to TWh.",
      "display_folder": "Generation",
      "format_string": "0.000 \"TWh\"",
      "name": "Reported Generation TWh",
      "unit": "TWh"
    },
    {
      "dax": "DIVIDE(SUM('Fact Hourly Energy'[renewable_generation_mwh]), 1000000)",
      "description": "Reported renewable generation summed over time and converted to TWh.",
      "display_folder": "Generation",
      "format_string": "0.000 \"TWh\"",
      "name": "Renewable Generation TWh",
      "unit": "TWh"
    },
    {
      "dax": "DIVIDE(CALCULATE(SUM('Fact Hourly Generation'[generation_mwh]), 'Fact Hourly Generation'[value_status] = \"reported\"), 1000000)",
      "description": "Reported generation for the selected technology, converted to TWh.",
      "display_folder": "Generation",
      "format_string": "0.000 \"TWh\"",
      "name": "Technology Generation TWh",
      "unit": "TWh"
    },
    {
      "dax": "DIVIDE(SUM('Fact Hourly Energy'[conventional_generation_mwh]), 1000000)",
      "description": "Reported conventional generation summed over time and converted to TWh.",
      "display_folder": "Generation",
      "format_string": "0.000 \"TWh\"",
      "name": "Conventional Generation TWh",
      "unit": "TWh"
    },
    {
      "dax": "DIVIDE(SUM('Fact Hourly Energy'[storage_generation_mwh]), 1000000)",
      "description": "Reported pumped-storage generation summed over time and converted to TWh.",
      "display_folder": "Generation",
      "format_string": "0.000 \"TWh\"",
      "name": "Storage Generation TWh",
      "unit": "TWh"
    },
    {
      "dax": "DIVIDE([Renewable Generation TWh], [Reported Generation TWh])",
      "description": "Renewable reported generation divided by all reported generation.",
      "display_folder": "Generation",
      "format_string": "0.00%",
      "name": "Renewable Share %",
      "unit": "percent"
    },
    {
      "dax": "AVERAGE('Fact Hourly Energy'[day_ahead_price_eur_per_mwh])",
      "description": "Arithmetic mean of hourly DE/LU day-ahead prices.",
      "display_folder": "Price",
      "format_string": "#,0.00 \"EUR/MWh\"",
      "name": "Average Day-Ahead Price",
      "unit": "EUR/MWh"
    },
    {
      "dax": "DIVIDE(SUM('Fact Daily Energy'[renewable_generation_mwh]), SUM('Fact Daily Energy'[reported_generation_mwh]))",
      "description": "Energy-weighted renewable share at the selected daily context.",
      "display_folder": "Price",
      "format_string": "0.00%",
      "name": "Daily Renewable Share %",
      "unit": "percent"
    },
    {
      "dax": "DIVIDE(SUMX('Fact Daily Energy', 'Fact Daily Energy'[average_day_ahead_price_eur_per_mwh] * 'Fact Daily Energy'[observed_hour_count]), SUM('Fact Daily Energy'[observed_hour_count]))",
      "description": "Observed-hour-weighted day-ahead price from daily reporting rows.",
      "display_folder": "Price",
      "format_string": "#,0.00 \"EUR/MWh\"",
      "name": "Daily Average Day-Ahead Price",
      "unit": "EUR/MWh"
    },
    {
      "dax": "CALCULATE(COUNTROWS('Fact Hourly Energy'), 'Fact Hourly Energy'[day_ahead_price_eur_per_mwh] < 0)",
      "description": "Count of hourly DE/LU day-ahead prices below zero.",
      "display_folder": "Price",
      "format_string": "#,0",
      "name": "Negative Price Hours",
      "unit": "count"
    },
    {
      "dax": "DIVIDE([Negative Price Hours], [Observed Hours])",
      "description": "Negative-price hours divided by observed canonical hours.",
      "display_folder": "Price",
      "format_string": "0.00%",
      "name": "Negative Price Share %",
      "unit": "percent"
    },
    {
      "dax": "SUM('Fact Hourly Energy'[unavailable_technology_count])",
      "description": "Unavailable hour/technology observations; never interpreted as zero.",
      "display_folder": "Data Quality",
      "format_string": "#,0",
      "name": "Unavailable Generation Values",
      "unit": "count"
    },
    {
      "dax": "AVERAGE('Fact Forecast Hourly'[model_absolute_error_mw])",
      "description": "Mean absolute error of the frozen selected model.",
      "display_folder": "Forecast",
      "format_string": "#,0.000 \"MW\"",
      "name": "Model MAE MW",
      "unit": "MW"
    },
    {
      "dax": "AVERAGE('Fact Forecast Hourly'[actual_grid_load_mw])",
      "description": "Actual hourly grid load for the frozen 2025 final-test rows.",
      "display_folder": "Forecast",
      "format_string": "#,0.000 \"MW\"",
      "name": "Actual Load MW",
      "unit": "MW"
    },
    {
      "dax": "AVERAGE('Fact Forecast Hourly'[model_prediction_mw])",
      "description": "Selected-model prediction for the frozen 2025 final-test rows.",
      "display_folder": "Forecast",
      "format_string": "#,0.000 \"MW\"",
      "name": "Model Prediction MW",
      "unit": "MW"
    },
    {
      "dax": "SQRT(AVERAGEX('Fact Forecast Hourly', POWER('Fact Forecast Hourly'[model_error_mw], 2)))",
      "description": "Root mean squared error of the frozen selected model.",
      "display_folder": "Forecast",
      "format_string": "#,0.000 \"MW\"",
      "name": "Model RMSE MW",
      "unit": "MW"
    },
    {
      "dax": "AVERAGEX('Fact Forecast Hourly', DIVIDE(ABS('Fact Forecast Hourly'[model_error_mw]), 'Fact Forecast Hourly'[actual_grid_load_mw]))",
      "description": "Mean absolute percentage error of the frozen selected model.",
      "display_folder": "Forecast",
      "format_string": "0.000%",
      "name": "Model MAPE %",
      "unit": "percent"
    },
    {
      "dax": "AVERAGEX('Fact Forecast Hourly', ABS('Fact Forecast Hourly'[daily_naive_prediction_mw] - 'Fact Forecast Hourly'[actual_grid_load_mw]))",
      "description": "Mean absolute error of the daily seasonal-naive baseline.",
      "display_folder": "Forecast",
      "format_string": "#,0.000 \"MW\"",
      "name": "Daily Baseline MAE MW",
      "unit": "MW"
    },
    {
      "dax": "AVERAGEX('Fact Forecast Hourly', ABS('Fact Forecast Hourly'[weekly_naive_prediction_mw] - 'Fact Forecast Hourly'[actual_grid_load_mw]))",
      "description": "Mean absolute error of the weekly seasonal-naive baseline.",
      "display_folder": "Forecast",
      "format_string": "#,0.000 \"MW\"",
      "name": "Weekly Baseline MAE MW",
      "unit": "MW"
    },
    {
      "dax": "DIVIDE([Weekly Baseline MAE MW] - [Model MAE MW], [Weekly Baseline MAE MW])",
      "description": "Relative MAE improvement of the selected model over the weekly baseline.",
      "display_folder": "Forecast",
      "format_string": "0.000%",
      "name": "Model Improvement vs Weekly %",
      "unit": "percent"
    },
    {
      "dax": "SWITCH(SELECTEDVALUE('Dim Forecast Series'[forecast_name], \"hist_gradient_boosting_31_leaves\"), \"daily_seasonal_naive\", [Daily Baseline MAE MW], \"weekly_seasonal_naive\", [Weekly Baseline MAE MW], [Model MAE MW])",
      "description": "MAE selected by the forecast-series slicer.",
      "display_folder": "Forecast",
      "format_string": "#,0.000 \"MW\"",
      "name": "Selected Forecast MAE MW",
      "unit": "MW"
    },
    {
      "dax": "CALCULATE(MAX('Fact Forecast Summary'[mae_mw]), 'Fact Forecast Summary'[evaluation_scope] = \"overall\")",
      "description": "Overall MAE for the forecast series selected in summary context.",
      "display_folder": "Forecast",
      "format_string": "#,0.000 \"MW\"",
      "name": "Overall Forecast MAE MW",
      "unit": "MW"
    },
    {
      "dax": "COUNTROWS('Data Quality Checks')",
      "description": "Number of stable clean-data validation checks.",
      "display_folder": "Data Quality",
      "format_string": "#,0",
      "name": "Data Quality Checks",
      "unit": "count"
    },
    {
      "dax": "CALCULATE(COUNTROWS('Data Quality Checks'), 'Data Quality Checks'[status] = \"passed\")",
      "description": "Number of clean-data checks with passing status.",
      "display_folder": "Data Quality",
      "format_string": "#,0",
      "name": "Passed Data Quality Checks",
      "unit": "count"
    },
    {
      "dax": "DIVIDE([Passed Data Quality Checks], [Data Quality Checks])",
      "description": "Passing checks divided by all declared checks.",
      "display_folder": "Data Quality",
      "format_string": "0.00%",
      "name": "Data Quality Pass Rate %",
      "unit": "percent"
    },
    {
      "dax": "COUNTROWS('Source Lineage')",
      "description": "Number of immutable registered SMARD source exports.",
      "display_folder": "Data Quality",
      "format_string": "#,0",
      "name": "Registered Source Snapshots",
      "unit": "count"
    }
  ],
  "model_rules": [
    "No fact-to-fact relationships",
    "No bidirectional relationships",
    "Every relationship is active one-to-many from dimension to fact",
    "UTC stays the unique fact timestamp; Europe/Berlin is for reporting",
    "MW, MWh, TWh, EUR/MWh, count, and percent remain distinct",
    "Base numeric columns use Do not summarize and report visuals use measures",
    "Foreign keys and technical lineage columns are hidden from report view",
    "The final 2025 forecast is evidence only and cannot drive model selection"
  ],
